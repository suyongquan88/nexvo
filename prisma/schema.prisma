generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum Locale {
  en
  zh
}

enum FavoriteSource {
  recommendation
  manual
}

/// Anonymous visitor session (minimal fields).
model VisitorSession {
  id        String   @id @default(cuid())
  token     String   @unique
  locale    Locale   @default(en)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  searchHistory SearchHistory[]
  favorites     Favorite[]
}

/// Search history metadata (no large JSON).
model SearchHistory {
  id            String   @id @default(cuid())
  sessionId     String
  snapshotId    String   @unique
  question      String
  locale        Locale
  answerPreview String?
  model         String?
  demo          Boolean  @default(false)
  createdAt     DateTime @default(now())

  session  VisitorSession         @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  snapshot RecommendationSnapshot @relation(fields: [snapshotId], references: [id], onDelete: Cascade)
  favorites Favorite[]

  @@index([sessionId, createdAt(sort: Desc)])
}

/// Full recommendation payload (linked from SearchHistory only).
model RecommendationSnapshot {
  id            String   @id @default(cuid())
  schemaVersion Int      @default(1)
  payload       Json
  createdAt     DateTime @default(now())

  history SearchHistory?
}

/// Saved product; flat fields for lists (no snapshot FK).
model Favorite {
  id            String         @id @default(cuid())
  sessionId     String
  productName   String
  searchKeyword String
  price         String?
  trustScore    Int?
  rank          Int?
  source        FavoriteSource @default(recommendation)
  historyId     String?
  createdAt     DateTime       @default(now())

  session VisitorSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  history SearchHistory?  @relation(fields: [historyId], references: [id], onDelete: SetNull)

  @@unique([sessionId, searchKeyword])
  @@index([sessionId, createdAt(sort: Desc)])
}
